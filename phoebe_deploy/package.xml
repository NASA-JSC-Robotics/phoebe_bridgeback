  <version>0.0.1</version>
  <description> Deploy package for Clearpath Ridgeback known as Phoebe Bridgeback </description>

  <maintainer email="jodi.s.graf@nasa.gov">Jodi Graf</maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>clearpath_desktop</exec_depend>
  <exec_depend>clearpath_common</exec_depend>
  <exec_depend>clearpath_robot</exec_depend>
  <exec_depend>ur</exec_depend>
