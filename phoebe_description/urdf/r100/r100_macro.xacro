<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">


    <!-- R100 Platform Macro -->
    <xacro:macro name="r100"
        params="wheel:='default'
                tf_prefix
                use_fake_hardware:=false
                sim_ignition:=false
                generate_ros2_control_tag:=true
                ns">


        <!-- Includes -->
        <xacro:include
            filename="$(find phoebe_description)/urdf/r100/wheels/wheel.urdf.xacro" ns="${ns}" />
        <xacro:include filename="$(find phoebe_description)/urdf/r100/rocker.urdf.xacro" />

        <xacro:arg name="gazebo_controllers"
            default="$(find phoebe_deploy)/config/${tf_prefix}control.yaml" />

        <!-- Variables -->
        <xacro:property name="wheel_radius" value="0.0759" />
        <xacro:property name="wheel_width" value="0.0790" />
        <xacro:property name="wheel_mass" value="2.5" />

        <xacro:property name="chassis_length" value="0.960" />
        <xacro:property name="chassis_width" value="0.793" />
        <xacro:property name="chassis_height" value="0.216" />
        <xacro:property name="deck_height" value="0.280" />
        <xacro:property name="deck_thickness" value="0.005" />

        <xacro:property name="riser_height" value="0.055" />

        <xacro:property name="axle_offset" value="0.0500" />
        <xacro:property name="rocker_offset" value="0.319" />
        <xacro:property name="rocker_width" value="0.472" />

        <xacro:property name="imu_offset_x" value="0.2085" />
        <xacro:property name="imu_offset_y" value="-0.2902" />
        <xacro:property name="imu_offset_z" value="0.1681" />

        <xacro:property name="dummy_inertia" value="1e-09" />


        <!-- Chassis -->
        <link name="${tf_prefix}base_link"></link>

        <joint name="${tf_prefix}base_link_joint" type="fixed">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <parent link="${tf_prefix}base_link" />
            <child link="${tf_prefix}chassis_link" />
        </joint>

        <link name="${tf_prefix}chassis_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://phoebe_description/meshes/visual/body.stl" />
                </geometry>
                <material name="clearpath_black" />
            </visual>
            <collision>
                <origin xyz="0 0 0" />
                <geometry>
                    <mesh filename="package://phoebe_description/meshes/visual/body-collision.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.012 0.002 0.067" rpy="${math.pi/2} 0 ${math.pi/2}" />
                <mass value="165.304" />
                <inertia
                    ixx="4.4744" ixy="0.03098" ixz="0.003647"
                    iyy="7.1624" iyz="0.1228"
                    izz="4.6155" />
            </inertial>
        </link>

        <!-- Covers -->
        <joint name="${tf_prefix}right_side_cover_link_joint" type="fixed">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <parent link="${tf_prefix}chassis_link" />
            <child link="${tf_prefix}right_side_cover_link" />
        </joint>
        <joint name="${tf_prefix}left_side_cover_link_joint" type="fixed">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <parent link="${tf_prefix}chassis_link" />
            <child link="${tf_prefix}left_side_cover_link" />
        </joint>

        <link name="${tf_prefix}left_side_cover_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 ${math.pi}" />
                <geometry>
                    <mesh filename="package://phoebe_description/meshes/visual/side-cover.stl" />
                </geometry>
                <material name="clearpath_yellow" />
            </visual>
        </link>
        <link name="${tf_prefix}right_side_cover_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://phoebe_description/meshes/visual/side-cover.stl" />
                </geometry>
                <material name="clearpath_yellow" />
            </visual>
        </link>

        <joint name="${tf_prefix}front_cover_link_joint" type="fixed">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <parent link="${tf_prefix}chassis_link" />
            <child link="${tf_prefix}front_cover_link" />
        </joint>

        <link name="${tf_prefix}front_cover_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://phoebe_description/meshes/visual/end-cover.stl" />
                </geometry>
                <material name="clearpath_black" />
            </visual>
        </link>

        <joint name="${tf_prefix}rear_cover_link_joint" type="fixed">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <parent link="${tf_prefix}chassis_link" />
            <child link="${tf_prefix}rear_cover_link" />
        </joint>

        <link name="${tf_prefix}rear_cover_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 ${math.pi}" />
                <geometry>
                    <mesh filename="package://phoebe_description/meshes/visual/end-cover.stl" />
                </geometry>
                <material name="clearpath_black" />
            </visual>
        </link>

        <!-- Lights -->
        <joint name="${tf_prefix}front_lights_link_joint" type="fixed">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <parent link="${tf_prefix}chassis_link" />
            <child link="${tf_prefix}front_lights_link" />
        </joint>
        <joint name="${tf_prefix}rear_lights_link_joint" type="fixed">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <parent link="${tf_prefix}chassis_link" />
            <child link="${tf_prefix}rear_lights_link" />
        </joint>

        <link name="${tf_prefix}front_lights_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://phoebe_description/meshes/visual/lights.stl" />
                </geometry>
                <material name="clearpath_white" />
            </visual>
        </link>
        <link name="${tf_prefix}rear_lights_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 ${math.pi}" />
                <geometry>
                    <mesh filename="package://phoebe_description/meshes/visual/lights.stl" />
                </geometry>
                <material name="clearpath_black" />
            </visual>
        </link>

        <!-- Axle -->
        <joint name="${tf_prefix}axle_joint" type="fixed">
            <origin xyz="0 0 ${axle_offset}" rpy="0 0 0" />
            <parent link="${tf_prefix}chassis_link" />
            <child link="${tf_prefix}axle_link" />
        </joint>

        <link name="${tf_prefix}axle_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 ${math.pi/2} 0" />
                <geometry>
                    <mesh filename="package://phoebe_description/meshes/visual/axle.stl" />
                </geometry>
                <material name="clearpath_black" />
            </visual>
        </link>

        <!-- Riser -->
        <joint name="${tf_prefix}riser_link_joint" type="fixed">
            <origin xyz="0 0 ${0.225 - deck_thickness}" rpy="0 0 0" />
            <parent link="${tf_prefix}chassis_link" />
            <child link="${tf_prefix}riser_link" />
        </joint>
        <link name="${tf_prefix}riser_link">
            <visual>
                <origin xyz="0 0 ${riser_height/2}" rpy="0 0 ${pi/4}" />
                <geometry>
                    <box size="0.493 0.493 ${riser_height}" />
                </geometry>
                <material name="clearpath_light_grey" />
            </visual>
            <collision>
                <origin xyz="0 0 ${riser_height/2}" rpy="0 0 ${pi/4}" />
                <geometry>
                    <box size="0.493 0.493 ${riser_height}" />
                </geometry>
            </collision>
        </link>

        <!-- Top Plate -->
        <joint name="${tf_prefix}top_link_joint" type="fixed">
            <origin xyz="0 0 ${riser_height-deck_height+deck_thickness}" rpy="0 0 0" />
            <parent link="${tf_prefix}riser_link" />
            <child link="${tf_prefix}top_link" />
        </joint>

        <link name="${tf_prefix}top_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://phoebe_description/meshes/visual/top.stl" />
                </geometry>
                <material name="clearpath_black" />
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://phoebe_description/meshes/visual/top.stl" />
                </geometry>
            </collision>
        </link>

        <!-- Rocker -->
        <xacro:r100_rocker prefix="front" joint_type="fixed" location="1" tf_prefix="${tf_prefix}">
            <limit lower="-0.08726" upper="0.08726" effort="0" velocity="0" />
        </xacro:r100_rocker>

        <xacro:r100_rocker prefix="rear" joint_type="fixed" location="-1" tf_prefix="${tf_prefix}">
            <limit effort="0" velocity="0" />
        </xacro:r100_rocker>

        <gazebo>
            <plugin filename="libignition-gazebo-wheel-slip-system.so"
                name="ignition::gazebo::systems::WheelSlip">
                <wheel link_name="${tf_prefix}front_left_wheel_link">
                    <slip_compliance_lateral>1.0</slip_compliance_lateral>
                    <slip_compliance_longitudinal>1.0</slip_compliance_longitudinal>
                    <wheel_normal_force>200</wheel_normal_force>
                    <wheel_radius>${wheel_radius}</wheel_radius>
                </wheel>
                <wheel link_name="${tf_prefix}front_right_wheel_link">
                    <slip_compliance_lateral>1.0</slip_compliance_lateral>
                    <slip_compliance_longitudinal>1.0</slip_compliance_longitudinal>
                    <wheel_normal_force>200</wheel_normal_force>
                    <wheel_radius>${wheel_radius}</wheel_radius>
                </wheel>
                <wheel link_name="${tf_prefix}rear_left_wheel_link">
                    <slip_compliance_lateral>1.0</slip_compliance_lateral>
                    <slip_compliance_longitudinal>1.0</slip_compliance_longitudinal>
                    <wheel_normal_force>200</wheel_normal_force>
                    <wheel_radius>${wheel_radius}</wheel_radius>
                </wheel>
                <wheel link_name="${tf_prefix}rear_right_wheel_link">
                    <slip_compliance_lateral>1.0</slip_compliance_lateral>
                    <slip_compliance_longitudinal>1.0</slip_compliance_longitudinal>
                    <wheel_normal_force>200</wheel_normal_force>
                    <wheel_radius>${wheel_radius}</wheel_radius>
                </wheel>
            </plugin>
        </gazebo>

        <!-- Internal IMU -->
        <link name="${tf_prefix}imu_0_link">
            <inertial>
                <mass value="0.001" />
                <origin xyz="0 0 0" rpy="0 0 0" />
                <inertia ixx="${dummy_inertia}" ixy="0.0" ixz="0.0" iyy="${dummy_inertia}" iyz="0.0"
                    izz="${dummy_inertia}" />
            </inertial>
        </link>
        <joint name="${tf_prefix}imu_0_joint" type="fixed">
            <parent link="${tf_prefix}chassis_link" />
            <child link="${tf_prefix}imu_0_link" />
            <origin xyz="${imu_offset_x} ${imu_offset_y} ${imu_offset_z}" rpy="0 0 0" />
        </joint>

        <gazebo reference="${tf_prefix}imu_0_link">
            <sensor type="imu" name="imu_0">
                <always_on>true</always_on>
                <update_rate>50</update_rate>
                <visualize>true</visualize>
                <ignition_frame_id>imu_0_link</ignition_frame_id>
            </sensor>
        </gazebo>

        <!-- Mounting Hardpoints -->
        <link name="${tf_prefix}default_mount" />
        <joint name="${tf_prefix}default_mount_joint" type="fixed">
            <parent link="${tf_prefix}riser_link" />
            <child link="${tf_prefix}default_mount" />
            <origin xyz="0 0 ${riser_height + deck_thickness}" rpy="0 0 0" />
        </joint>

        <!-- Gazebo Controller -->
        <xacro:if value="${generate_ros2_control_tag}">
            <xacro:include filename="$(find phoebe_description)/urdf/r100/r100.ros2_control.xacro"/>
            <xacro:r100_ros2_control
            name="r100"
            use_fake_hardware="${use_fake_hardware}"
            sim_ignition="${sim_ignition}"
            tf_prefix="${tf_prefix}"
            />
        </xacro:if>

    </xacro:macro>
</robot>
