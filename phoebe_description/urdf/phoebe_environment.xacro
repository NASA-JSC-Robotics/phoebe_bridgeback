<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="phoebe_environment">

  <!-- ===================== MATERIALS ===================== -->
  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <material name="blue">
    <color rgba="0.1 0.1 0.3 1"/>
  </material>

  <material name="brown">
    <color rgba="0.42 0.22 0.16 1"/>
  </material>

  <material name="gray">
    <color rgba="0.7 0.7 0.7 1"/>
  </material>

  <!-- ===================== MACRO ===================== -->
  <xacro:macro name="phoebe_environment">

    <!-- WORLD -->
    <link name="world"/>

    <!-- ===================== FLOOR ===================== -->
    <link name="floor">
      <visual>
        <geometry>
          <plane normal="0 0 1"/>
        </geometry>
        <material name="gray"/>
      </visual>
      <collision>
        <geometry>
          <plane normal="0 0 1"/>
        </geometry>
      </collision>
    </link>

    <joint name="world_to_floor" type="fixed">
      <parent link="world"/>
      <child link="floor"/>
    </joint>

    <!-- ===================== BOOKSHELVES (CABINETS) ===================== -->
    <link name="bookshelves">

      <!-- right shelf -->
      <visual>
        <origin xyz="1.55 -2.25 0.75"/>
        <geometry>
          <box size="3.0 0.5 1.5"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="1.55 -2.25 0.75"/>
        <geometry>
          <box size="3.0 0.5 1.5"/>
        </geometry>
      </collision>

      <!-- left shelf -->
      <visual>
        <origin xyz="-1.55 -2.25 0.75"/>
        <geometry>
          <box size="3.0 0.5 1.5"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="-1.55 -2.25 0.75"/>
        <geometry>
          <box size="3.0 0.5 1.5"/>
        </geometry>
      </collision>

    </link>

    <joint name="world_to_bookshelves" type="fixed">
      <parent link="world"/>
      <child link="bookshelves"/>
    </joint>

    <!-- ===================== TABLES ===================== -->
    <link name="tables">

      <!-- pick table -->
      <visual>
        <origin xyz="3.0 -0.666 0.333"/>
        <geometry>
          <box size="0.666 1.332 0.666"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="3.0 -0.666 0.333"/>
        <geometry>
          <box size="0.666 1.332 0.666"/>
        </geometry>
      </collision>

      <!-- place table -->
      <visual>
        <origin xyz="-2.25 -0.666 0.333"/>
        <geometry>
          <box size="0.666 0.666 0.666"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="-2.25 -0.666 0.333"/>
        <geometry>
          <box size="0.666 0.666 0.666"/>
        </geometry>
      </collision>

    </link>

    <joint name="world_to_tables" type="fixed">
      <parent link="world"/>
      <child link="tables"/>
    </joint>

    <!-- ===================== DESKS ===================== -->
    <link name="desks">

      <!-- desk 1 -->
      <visual>
        <origin xyz="3.0 1.0 0.333" rpy="0 0 0.523599"/>
        <geometry>
          <box size="0.666 1.332 0.666"/>
        </geometry>
        <material name="brown"/>
      </visual>
      <collision>
        <origin xyz="3.0 1.0 0.333" rpy="0 0 0.523599"/>
        <geometry>
          <box size="0.666 1.332 0.666"/>
        </geometry>
      </collision>

      <!-- desk 2 -->
      <visual>
        <origin xyz="1.85 2.0 0.333" rpy="0 0 1.2"/>
        <geometry>
          <box size="0.666 1.332 0.666"/>
        </geometry>
        <material name="brown"/>
      </visual>
      <collision>
        <origin xyz="1.85 2.0 0.333" rpy="0 0 1.2"/>
        <geometry>
          <box size="0.666 1.332 0.666"/>
        </geometry>
      </collision>

      <!-- desk 3 -->
      <visual>
        <origin xyz="-0.25 2.25 0.333" rpy="0 0 1.57"/>
        <geometry>
          <box size="0.666 2.5 0.666"/>
        </geometry>
        <material name="brown"/>
      </visual>
      <collision>
        <origin xyz="-0.25 2.25 0.333" rpy="0 0 1.57"/>
        <geometry>
          <box size="0.666 2.5 0.666"/>
        </geometry>
      </collision>

    </link>

    <joint name="world_to_desks" type="fixed">
      <parent link="world"/>
      <child link="desks"/>
    </joint>

  </xacro:macro>

  <!-- ===================== INSTANTIATE MACRO ===================== -->
  <xacro:phoebe_environment/>

</robot>