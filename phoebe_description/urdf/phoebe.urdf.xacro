<?xml version="1.0"?>
<robot name="phoebe" xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:arg name="tf_prefix" default="" />
    <xacro:arg name="ns" default="" />
    <xacro:arg name="use_fake_hardware" default="false" />
    <xacro:arg name="sim_ignition" default="false" />
    <xacro:arg name="left_ewellix_com_port" default="/dev/ewellix_left" />
    <xacro:arg name="right_ewellix_com_port" default="/dev/ewellix_right" />
    <xacro:arg name="left_hande_com_port" default="/tmp/hande_left" />
    <xacro:arg name="right_hande_com_port" default="/tmp/hande_right" />
    <xacro:arg name="left_ur_ip_addr" default="192.168.131.40" />
    <xacro:arg name="right_ur_ip_addr" default="192.168.131.41" />
    <xacro:arg name="left_ur_kinematics_file" default="$(find phoebe_description)/config/left_ur_calibration.yaml" />
    <xacro:arg name="right_ur_kinematics_file" default="$(find phoebe_description)/config/right_ur_calibration.yaml" />
    <xacro:arg name="left_liftkit_calibration_file" default="$(find phoebe_description)/config/left_liftkit_calibration.yaml" />
    <xacro:arg name="right_liftkit_calibration_file" default="$(find phoebe_description)/config/right_liftkit_calibration.yaml" />
    <xacro:arg name="liftkit_mount_calibration_file" default="$(find phoebe_description)/config/liftkit_mount_calibration.yaml" />

    <!-- Includes -->
    <xacro:include filename="$(find phoebe_description)/urdf/phoebe_macro.xacro" />

    <xacro:phoebe
        ns="$(arg ns)"
        tf_prefix="$(arg tf_prefix)"
        use_fake_hardware="$(arg use_fake_hardware)"
        sim_ignition="$(arg sim_ignition)"
        left_ewellix_com_port="$(arg left_ewellix_com_port)"
        right_ewellix_com_port="$(arg right_ewellix_com_port)"
        left_hande_com_port="$(arg left_hande_com_port)"
        right_hande_com_port="$(arg right_hande_com_port)"
        left_ur_ip_addr="$(arg left_ur_ip_addr)"
        right_ur_ip_addr="$(arg right_ur_ip_addr)"
        left_ur_kinematics_file="$(arg left_ur_kinematics_file)"
        right_ur_kinematics_file="$(arg right_ur_kinematics_file)"
        left_liftkit_calibration_file="$(arg left_liftkit_calibration_file)"
        right_liftkit_calibration_file="$(arg right_liftkit_calibration_file)"
        liftkit_mount_calibration_file="$(arg liftkit_mount_calibration_file)"
    />
</robot>
