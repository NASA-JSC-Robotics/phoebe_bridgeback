	<joint name="left_ur_arm_wrist_3_link-ft_frame" type="fixed">
		<parent link="left_ur_arm_wrist_3_link"/>
		<child link="left_ur_arm_ft_frame"/>
		<origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
