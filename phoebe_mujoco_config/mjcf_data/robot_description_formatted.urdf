	<!-- base_joint fixes base_link to the environment -->
	<joint name="right_ur_arm_base_joint" type="fixed">
		<origin rpy="0 0 3.9269908169872414" xyz="0 0 0"/>
		<parent link="right_arm_mount_plate_2"/>
		<child link="right_ur_arm_base_link"/>
	</joint>
	<!-- joints - main serial chain -->
	<joint name="right_ur_arm_base_link-base_link_inertia" type="fixed">
		<parent link="right_ur_arm_base_link"/>
		<child link="right_ur_arm_base_link_inertia"/>
		<!-- 'base_link' is REP-103 aligned (so X+ forward), while the internal
           frames of the robot/controller have X+ pointing backwards.
           Use the joint between 'base_link' and 'base_link_inertia' (a dummy
           link/frame) to introduce the necessary rotation over Z (of pi rad).
      -->
		<origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
	</joint>
	<joint name="right_ur_arm_shoulder_pan_joint" type="revolute">
		<parent link="right_ur_arm_base_link_inertia"/>
		<child link="right_ur_arm_shoulder_link"/>
		<origin rpy="0 0 -1.2257078885885564e-07" xyz="0 0 0.1627194414394422"/>
		<axis xyz="0 0 1"/>
		<limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
		<dynamics damping="0" friction="0"/>
	</joint>
	<joint name="right_ur_arm_shoulder_lift_joint" type="revolute">
		<parent link="right_ur_arm_shoulder_link"/>
		<child link="right_ur_arm_upper_arm_link"/>
		<origin rpy="1.5702347906176382 0 4.027385058581037e-06" xyz="7.086814894058389e-05 0 0"/>
		<axis xyz="0 0 1"/>
		<limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
		<dynamics damping="0" friction="0"/>
	</joint>
	<joint name="right_ur_arm_elbow_joint" type="revolute">
		<parent link="right_ur_arm_upper_arm_link"/>
		<child link="right_ur_arm_forearm_link"/>
		<origin rpy="0.00019412315080351384 0.0005387074183248353 9.906974049126056e-07" xyz="-0.42530420287576587 0 0"/>
		<axis xyz="0 0 1"/>
		<limit effort="150.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793"/>
		<dynamics damping="0" friction="0"/>
	</joint>
	<joint name="right_ur_arm_wrist_1_joint" type="revolute">
		<parent link="right_ur_arm_forearm_link"/>
		<child link="right_ur_arm_wrist_1_link"/>
		<origin rpy="3.1409319568707947 3.1405749364666664 3.141589424420742" xyz="-0.3921838149598094 8.853859993209068e-05 0.13400791089649564"/>
		<axis xyz="0 0 1"/>
		<limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
		<dynamics damping="0" friction="0"/>
	</joint>
	<joint name="right_ur_arm_wrist_2_joint" type="revolute">
		<parent link="right_ur_arm_wrist_1_link"/>
		<child link="right_ur_arm_wrist_2_link"/>
		<origin rpy="1.5699724067415992 0 5.781763395343308e-07" xyz="3.885044539989715e-05 -0.09980729332488365 8.2233249043565e-05"/>
		<axis xyz="0 0 1"/>
		<limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
		<dynamics damping="0" friction="0"/>
	</joint>
	<joint name="right_ur_arm_wrist_3_joint" type="revolute">
		<parent link="right_ur_arm_wrist_2_link"/>
		<child link="right_ur_arm_wrist_3_link"/>
		<origin rpy="1.5709132401857624 3.141592653589793 -3.1415926420704148" xyz="7.984047159275562e-05 0.09963405243244176 1.1648554968661052e-05"/>
		<axis xyz="0 0 1"/>
		<limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
		<dynamics damping="0" friction="0"/>
	</joint>
	<link name="right_ur_arm_ft_frame"/>
	<joint name="right_ur_arm_wrist_3_link-ft_frame" type="fixed">
		<parent link="right_ur_arm_wrist_3_link"/>
		<child link="right_ur_arm_ft_frame"/>
		<origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
	</joint>
	<!-- ROS-Industrial 'base' frame - base_link to UR 'Base' Coordinates transform -->
	<link name="right_ur_arm_base"/>
	<joint name="right_ur_arm_base_link-base_fixed_joint" type="fixed">
		<!-- Note the rotation over Z of pi radians - as base_link is REP-103
           aligned (i.e., has X+ forward, Y+ left and Z+ up), this is needed
           to correctly align 'base' with the 'Base' coordinate system of
           the UR controller.
      -->
		<origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
		<parent link="right_ur_arm_base_link"/>
		<child link="right_ur_arm_base"/>
	</joint>
	<!-- ROS-Industrial 'flange' frame - attachment point for EEF models -->
	<link name="right_ur_arm_flange"/>
	<joint name="right_ur_arm_wrist_3-flange" type="fixed">
		<parent link="right_ur_arm_wrist_3_link"/>
		<child link="right_ur_arm_flange"/>
		<origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0"/>
	</joint>
	<!-- ROS-Industrial 'tool0' frame - all-zeros tool frame -->
	<link name="right_ur_arm_tool0"/>
	<joint name="right_ur_arm_flange-tool0" type="fixed">
		<!-- default toolframe - X+ left, Y+ up, Z+ front -->
		<origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
		<parent link="right_ur_arm_flange"/>
		<child link="right_ur_arm_tool0"/>
	</joint>
	<!-- left ur -->
	<ros2_control name="left_ur5e" type="system">
		<hardware>
			<plugin>ur_robot_driver/URPositionHardwareInterface</plugin>
			<param name="robot_ip">0.0.0.0</param>
			<param name="script_filename">to_be_filled_by_ur_robot_driver</param>
			<param name="output_recipe_filename">to_be_filled_by_ur_robot_driver</param>
			<param name="input_recipe_filename">to_be_filled_by_ur_robot_driver</param>
			<param name="headless_mode">False</param>
			<param name="reverse_port">50001</param>
			<param name="script_sender_port">50002</param>
			<param name="reverse_ip">0.0.0.0</param>
			<param name="script_command_port">50004</param>
			<param name="trajectory_port">50003</param>
			<param name="tf_prefix">left_ur_arm_</param>
			<param name="non_blocking_read">True</param>
			<param name="servoj_gain">2000</param>
			<param name="servoj_lookahead_time">0.03</param>
			<param name="use_tool_communication">False</param>
			<param name="kinematics/hash">calib_1285100130094105689</param>
			<param name="tool_voltage">0</param>
			<param name="tool_parity">0</param>
			<param name="tool_baud_rate">115200</param>
			<param name="tool_stop_bits">1</param>
			<param name="tool_rx_idle_chars">1.5</param>
			<param name="tool_tx_idle_chars">3.5</param>
			<param name="tool_device_name">/tmp/ttyUR</param>
			<param name="tool_tcp_port">54321</param>
			<param name="keep_alive_count">2</param>
		</hardware>
		<joint name="left_ur_arm_shoulder_pan_joint">
			<command_interface name="position"/>
			<command_interface name="velocity"/>
			<command_interface name="effort"/>
			<state_interface name="position">
				<!-- initial position for the FakeSystem and simulation -->
				<param name="initial_value">0.0</param>
			</state_interface>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="left_ur_arm_shoulder_lift_joint">
			<command_interface name="position"/>
			<command_interface name="velocity"/>
			<command_interface name="effort"/>
			<state_interface name="position">
				<!-- initial position for the FakeSystem and simulation -->
				<param name="initial_value">-1.57</param>
			</state_interface>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="left_ur_arm_elbow_joint">
			<command_interface name="position"/>
			<command_interface name="velocity"/>
			<command_interface name="effort"/>
			<state_interface name="position">
				<!-- initial position for the FakeSystem and simulation -->
				<param name="initial_value">0.0</param>
			</state_interface>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="left_ur_arm_wrist_1_joint">
			<command_interface name="position"/>
			<command_interface name="velocity"/>
			<command_interface name="effort"/>
			<state_interface name="position">
				<!-- initial position for the FakeSystem and simulation -->
				<param name="initial_value">-1.57</param>
			</state_interface>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="left_ur_arm_wrist_2_joint">
			<command_interface name="position"/>
			<command_interface name="velocity"/>
			<command_interface name="effort"/>
			<state_interface name="position">
				<!-- initial position for the FakeSystem and simulation -->
				<param name="initial_value">0.0</param>
			</state_interface>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="left_ur_arm_wrist_3_joint">
			<command_interface name="position"/>
			<command_interface name="velocity"/>
			<command_interface name="effort"/>
			<state_interface name="position">
				<!-- initial position for the FakeSystem and simulation -->
				<param name="initial_value">0.0</param>
			</state_interface>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<sensor name="left_ur_arm_tcp_fts_sensor">
			<state_interface name="force.x"/>
			<state_interface name="force.y"/>
			<state_interface name="force.z"/>
			<state_interface name="torque.x"/>
			<state_interface name="torque.y"/>
			<state_interface name="torque.z"/>
		</sensor>
		<sensor name="left_ur_arm_tcp_pose">
			<state_interface name="position.x"/>
			<state_interface name="position.y"/>
			<state_interface name="position.z"/>
			<state_interface name="orientation.x"/>
			<state_interface name="orientation.y"/>
			<state_interface name="orientation.z"/>
			<state_interface name="orientation.w"/>
		</sensor>
