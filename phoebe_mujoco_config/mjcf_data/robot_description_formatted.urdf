	<!-- base_joint fixes base_link to the environment -->
	<joint name="left_ur_arm_base_joint" type="fixed">
		<origin rpy="0 0 -0.7853981633974483" xyz="0 0 0"/>
		<parent link="left_arm_mount_plate_2"/>
		<child link="left_ur_arm_base_link"/>
	</joint>
	<!-- joints - main serial chain -->
	<joint name="left_ur_arm_base_link-base_link_inertia" type="fixed">
		<parent link="left_ur_arm_base_link"/>
		<child link="left_ur_arm_base_link_inertia"/>
		<!-- 'base_link' is REP-103 aligned (so X+ forward), while the internal
           frames of the robot/controller have X+ pointing backwards.
           Use the joint between 'base_link' and 'base_link_inertia' (a dummy
           link/frame) to introduce the necessary rotation over Z (of pi rad).
      -->
		<origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
	</joint>
	<joint name="left_ur_arm_shoulder_pan_joint" type="revolute">
		<parent link="left_ur_arm_base_link_inertia"/>
		<child link="left_ur_arm_shoulder_link"/>
		<origin rpy="0 0 2.0353112055448985e-07" xyz="0 0 0.16285165531976517"/>
		<axis xyz="0 0 1"/>
		<limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
		<dynamics damping="0" friction="0"/>
	</joint>
	<joint name="left_ur_arm_shoulder_lift_joint" type="revolute">
		<parent link="left_ur_arm_shoulder_link"/>
		<child link="left_ur_arm_upper_arm_link"/>
		<origin rpy="1.5707717284457485 0 -2.701557929807308e-06" xyz="0.00022678223787788696 0 0"/>
		<axis xyz="0 0 1"/>
		<limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
		<dynamics damping="0" friction="0"/>
	</joint>
	<joint name="left_ur_arm_elbow_joint" type="revolute">
		<parent link="left_ur_arm_upper_arm_link"/>
		<child link="left_ur_arm_forearm_link"/>
		<origin rpy="4.144531889279615e-05 -0.0005259747748149342 -1.631805507648799e-07" xyz="-0.4255053481339793 0 0"/>
		<axis xyz="0 0 1"/>
		<limit effort="150.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793"/>
		<dynamics damping="0" friction="0"/>
	</joint>
	<joint name="left_ur_arm_wrist_1_joint" type="revolute">
		<parent link="left_ur_arm_forearm_link"/>
		<child link="left_ur_arm_wrist_1_link"/>
		<origin rpy="0.00034633437694508626 0.0010890336747668942 3.746247396438229e-06" xyz="-0.39258221935685805 -4.631221569112638e-05 0.13372109996112605"/>
		<axis xyz="0 0 1"/>
		<limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
		<dynamics damping="0" friction="0"/>
	</joint>
	<joint name="left_ur_arm_wrist_2_joint" type="revolute">
		<parent link="left_ur_arm_wrist_1_link"/>
		<child link="left_ur_arm_wrist_2_link"/>
		<origin rpy="1.5699475464649277 0 -1.3138999051254266e-07" xyz="1.3698888834354598e-05 -0.09997770174370377 8.485912705385104e-05"/>
		<axis xyz="0 0 1"/>
		<limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
		<dynamics damping="0" friction="0"/>
	</joint>
	<joint name="left_ur_arm_wrist_3_joint" type="revolute">
		<parent link="left_ur_arm_wrist_2_link"/>
		<child link="left_ur_arm_wrist_3_link"/>
		<origin rpy="1.5709920410525182 3.141592653589793 -3.141592598819571" xyz="0.00010673329085354067 0.09961581341188114 1.949623521821858e-05"/>
		<axis xyz="0 0 1"/>
