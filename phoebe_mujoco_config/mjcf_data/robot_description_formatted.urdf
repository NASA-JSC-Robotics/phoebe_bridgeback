	<link name="apriltag_1">
		<visual>
			<geometry>
				<box size="0.214 0.214 0.002"/>
			</geometry>
			<material name="tag36h11-1">
				<texture filename="/home/er4-user/ws/install/phoebe_description/share/phoebe_description/meshes/visual/april_tags/tag36_11_00001.png"/>
			</material>
		</visual>
	</link>
	<joint name="apriltag_1_joint" type="fixed">
		<parent link="mobile_environment_base"/>
		<child link="apriltag_1"/>
		<origin rpy="-0.785 0 3.14159" xyz="0.134059 -1.788736 2.822666"/>
	</joint>
	<mujoco_inputs>
		<raw_inputs>
			<option cone="elliptic" impratio="20" integrator="implicitfast" noslip_iterations="5">
				<flag multiccd="enable"/>
			</option>
			<default>
				<default class="phoebe">
					<material shininess="0.25" specular="0.5"/>
					<joint armature="0.1" axis="0 1 0" range="-6.28319 6.28319"/>
					<position ctrlrange="-6.2831 6.2831"/>
					<general biastype="affine" ctrlrange="-6.2831 6.2831"/>
					<default class="size4">
						<joint damping="10"/>
						<general biasprm="0 -100000 -10000" forcerange="-330 330" gainprm="100000"/>
					</default>
					<default class="size3">
						<joint damping="5"/>
						<general biasprm="0 -100000 -5000" forcerange="-150 150" gainprm="100000"/>
						<default class="size3_limited">
							<joint range="-3.1415 3.1415"/>
							<general ctrlrange="-3.1415 3.1415"/>
						</default>
					</default>
					<default class="size2">
						<joint damping="2"/>
						<general biasprm="0 -100000 -1000" forcerange="-56 56" gainprm="100000"/>
					</default>
					<default class="visual">
						<geom conaffinity="0" contype="0" group="2" type="mesh"/>
					</default>
					<default class="collision">
						<geom group="3" type="mesh"/>
						<default class="rubber">
							<geom conaffinity="1" condim="4" friction="5 1.0 1.0" priority="1" solimp="0.9 0.95 0.001" solref="0.002 1"/>
						</default>
					</default>
					<default class="right_spring_link">
						<joint armature="0.001" damping="0.00125" range="-0.9 0.29670597283" springref="-2.62" stiffness="0.05"/>
					</default>
					<default class="left_spring_link">
						<joint armature="0.001" damping="0.00125" range="-0.29670597283 0.9" springref="2.62" stiffness="0.05"/>
					</default>
				</default>
			</default>
			<actuator>
				<position ctrlrange="0.0 0.7" dampratio="1.0" joint="left_ewellix_lift_lower_to_higher" kp="75000" name="left_ewellix_lift_lower_to_higher"/>
				<position ctrlrange="0.0 0.7" dampratio="1.0" joint="right_ewellix_lift_lower_to_higher" kp="75000" name="right_ewellix_lift_lower_to_higher"/>
				<position ctrlrange="0.0 0.8" dampratio="10.0" forcerange="-20 20" kp="100000" name="right_robotiq_85_left_knuckle_joint" tendon="right_split"/>
				<position ctrlrange="0.0 0.025" dampratio="10.0" forcerange="-130 130" kp="10000" name="left_finger_1_joint" tendon="left_split"/>
				<general class="size4" joint="left_ur_arm_shoulder_pan_joint" name="left_ur_arm_shoulder_pan_joint"/>
				<general class="size4" joint="left_ur_arm_shoulder_lift_joint" name="left_ur_arm_shoulder_lift_joint"/>
				<general class="size3_limited" joint="left_ur_arm_elbow_joint" name="left_ur_arm_elbow_joint"/>
				<general class="size2" joint="left_ur_arm_wrist_1_joint" name="left_ur_arm_wrist_1_joint"/>
				<general class="size2" joint="left_ur_arm_wrist_2_joint" name="left_ur_arm_wrist_2_joint"/>
				<general class="size2" joint="left_ur_arm_wrist_3_joint" name="left_ur_arm_wrist_3_joint"/>
				<general class="size4" joint="right_ur_arm_shoulder_pan_joint" name="right_ur_arm_shoulder_pan_joint"/>
				<general class="size4" joint="right_ur_arm_shoulder_lift_joint" name="right_ur_arm_shoulder_lift_joint"/>
				<general class="size3_limited" joint="right_ur_arm_elbow_joint" name="right_ur_arm_elbow_joint"/>
				<general class="size2" joint="right_ur_arm_wrist_1_joint" name="right_ur_arm_wrist_1_joint"/>
				<general class="size2" joint="right_ur_arm_wrist_2_joint" name="right_ur_arm_wrist_2_joint"/>
				<general class="size2" joint="right_ur_arm_wrist_3_joint" name="right_ur_arm_wrist_3_joint"/>
				<velocity ctrlrange="-15 15" joint="front_right_wheel_joint" kv="50" name="front_right_wheel_joint"/>
				<velocity ctrlrange="-15 15" joint="front_left_wheel_joint" kv="50" name="front_left_wheel_joint"/>
				<velocity ctrlrange="-15 15" joint="rear_right_wheel_joint" kv="50" name="rear_right_wheel_joint"/>
				<velocity ctrlrange="-15 15" joint="rear_left_wheel_joint" kv="50" name="rear_left_wheel_joint"/>
			</actuator>
			<contact>
				<exclude body1="base_link" body2="left_ewellix_lift_higher_link"/>
				<exclude body1="base_link" body2="left_ewellix_lift_middle_link"/>
        \
				<exclude body1="base_link" body2="right_ewellix_lift_higher_link"/>
				<exclude body1="base_link" body2="right_ewellix_lift_middle_link"/>
				<exclude body1="base_link" body2="rear_left_wheel_link"/>
				<exclude body1="base_link" body2="rear_left_wheel_roller_0_link"/>
				<exclude body1="base_link" body2="rear_left_wheel_roller_1_link"/>
				<exclude body1="base_link" body2="rear_left_wheel_roller_2_link"/>
				<exclude body1="base_link" body2="rear_left_wheel_roller_3_link"/>
				<exclude body1="base_link" body2="rear_left_wheel_roller_4_link"/>
				<exclude body1="base_link" body2="rear_left_wheel_roller_5_link"/>
				<exclude body1="base_link" body2="rear_left_wheel_roller_6_link"/>
				<exclude body1="base_link" body2="rear_left_wheel_roller_7_link"/>
				<exclude body1="base_link" body2="rear_right_wheel_link"/>
				<exclude body1="base_link" body2="rear_right_wheel_roller_0_link"/>
				<exclude body1="base_link" body2="rear_right_wheel_roller_1_link"/>
				<exclude body1="base_link" body2="rear_right_wheel_roller_2_link"/>
				<exclude body1="base_link" body2="rear_right_wheel_roller_3_link"/>
				<exclude body1="base_link" body2="rear_right_wheel_roller_4_link"/>
				<exclude body1="base_link" body2="rear_right_wheel_roller_5_link"/>
				<exclude body1="base_link" body2="rear_right_wheel_roller_6_link"/>
				<exclude body1="base_link" body2="rear_right_wheel_roller_7_link"/>
				<exclude body1="base_link" body2="front_left_wheel_link"/>
				<exclude body1="base_link" body2="front_left_wheel_roller_0_link"/>
				<exclude body1="base_link" body2="front_left_wheel_roller_1_link"/>
				<exclude body1="base_link" body2="front_left_wheel_roller_2_link"/>
				<exclude body1="base_link" body2="front_left_wheel_roller_3_link"/>
				<exclude body1="base_link" body2="front_left_wheel_roller_4_link"/>
				<exclude body1="base_link" body2="front_left_wheel_roller_5_link"/>
				<exclude body1="base_link" body2="front_left_wheel_roller_6_link"/>
				<exclude body1="base_link" body2="front_left_wheel_roller_7_link"/>
				<exclude body1="base_link" body2="front_right_wheel_link"/>
				<exclude body1="base_link" body2="front_right_wheel_roller_0_link"/>
				<exclude body1="base_link" body2="front_right_wheel_roller_1_link"/>
				<exclude body1="base_link" body2="front_right_wheel_roller_2_link"/>
				<exclude body1="base_link" body2="front_right_wheel_roller_3_link"/>
				<exclude body1="base_link" body2="front_right_wheel_roller_4_link"/>
				<exclude body1="base_link" body2="front_right_wheel_roller_5_link"/>
				<exclude body1="base_link" body2="front_right_wheel_roller_6_link"/>
				<exclude body1="base_link" body2="front_right_wheel_roller_7_link"/>
			</contact>
			<!-- let hand - hande -->
			<tendon>
				<fixed name="left_split">
					<joint coef="0.5" joint="left_finger_1_joint"/>
					<joint coef="0.5" joint="left_finger_2_joint"/>
				</fixed>
			</tendon>
			<equality>
				<joint joint1="left_finger_1_joint" joint2="left_finger_2_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
			</equality>
			<!-- right hand - 2f-85 -->
			<tendon>
				<fixed name="right_split">
					<joint coef="0.485" joint="right_robotiq_85_left_knuckle_joint"/>
					<joint coef="-0.485" joint="right_robotiq_85_right_knuckle_joint"/>
				</fixed>
			</tendon>
			<equality>
				<connect anchor="-0.0371575 0.0 0.043422" body1="right_robotiq_85_right_inner_knuckle_link" body2="right_robotiq_85_right_finger_tip_link" solimp="0.95 0.99 0.001" solref="0.005 1"/>
				<connect anchor="0.0371575 0.0 0.043422" body1="right_robotiq_85_left_inner_knuckle_link" body2="right_robotiq_85_left_finger_tip_link" solimp="0.95 0.99 0.001" solref="0.005 1"/>
				<joint joint1="right_robotiq_85_left_knuckle_joint" joint2="right_robotiq_85_right_knuckle_joint" polycoef="0 -1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
			</equality>
			<contact>
				<exclude body1="right_ur_arm_wrist_3_link" body2="right_robotiq_85_right_inner_knuckle_link"/>
				<exclude body1="right_ur_arm_wrist_3_link" body2="right_robotiq_85_left_inner_knuckle_link"/>
				<exclude body1="right_ur_arm_wrist_3_link" body2="right_robotiq_85_right_knuckle_link"/>
				<exclude body1="right_ur_arm_wrist_3_link" body2="right_robotiq_85_left_knuckle_link"/>
				<exclude body1="right_ur_arm_wrist_3_link" body2="right_robotiq_85_right_finger_tip_link"/>
				<exclude body1="right_ur_arm_wrist_3_link" body2="right_robotiq_85_left_finger_tip_link"/>
				<exclude body1="right_robotiq_85_right_finger_tip_link" body2="right_robotiq_85_right_knuckle_link"/>
				<exclude body1="right_robotiq_85_left_finger_tip_link" body2="right_robotiq_85_left_knuckle_link"/>
				<exclude body1="right_robotiq_85_right_finger_tip_link" body2="right_robotiq_85_right_finger_coupler_link"/>
				<exclude body1="right_robotiq_85_left_finger_tip_link" body2="right_robotiq_85_left_finger_coupler_link"/>
				<exclude body1="right_robotiq_85_right_knuckle_link" body2="right_robotiq_85_right_finger_coupler_link"/>
				<exclude body1="right_robotiq_85_left_knuckle_link" body2="right_robotiq_85_left_finger_coupler_link"/>
				<exclude body1="right_robotiq_85_right_inner_knuckle_link" body2="right_robotiq_85_right_finger_tip_link"/>
				<exclude body1="right_robotiq_85_left_inner_knuckle_link" body2="right_robotiq_85_left_finger_tip_link"/>
				<exclude body1="right_robotiq_85_right_inner_knuckle_link" body2="right_robotiq_85_right_finger_coupler_link"/>
				<exclude body1="right_robotiq_85_left_inner_knuckle_link" body2="right_robotiq_85_left_finger_coupler_link"/>
				<exclude body1="right_robotiq_85_right_inner_knuckle_link" body2="right_robotiq_85_right_knuckle_link"/>
				<exclude body1="right_robotiq_85_left_inner_knuckle_link" body2="right_robotiq_85_left_knuckle_link"/>
			</contact>
			<tendon>
				<fixed name="left_lift_middle_mimic_higher">
					<joint coef="0.5" joint="left_ewellix_lift_lower_to_higher"/>
					<joint coef="0.5" joint="left_middle_mimic_higher"/>
				</fixed>
			</tendon>
			<tendon>
				<fixed name="right_lift_middle_mimic_higher">
					<joint coef="0.5" joint="right_ewellix_lift_lower_to_higher"/>
					<joint coef="0.5" joint="right_middle_mimic_higher"/>
				</fixed>
			</tendon>
			<equality>
				<joint joint1="left_ewellix_lift_lower_to_higher" joint2="left_middle_mimic_higher" name="left_upper_mimic_lower" polycoef="0 2 0 0 0"/>
			</equality>
			<equality>
				<joint joint1="right_ewellix_lift_lower_to_higher" joint2="right_middle_mimic_higher" name="right_upper_mimic_lower" polycoef="0 2 0 0 0"/>
			</equality>
			<sensor>
				<force name="left_ur_arm_tcp_fts_sensor_force" site="left_ur_arm_ft_frame"/>
				<torque name="left_ur_arm_tcp_fts_sensor_torque" site="left_ur_arm_ft_frame"/>
			</sensor>
			<sensor>
				<force name="right_ur_arm_tcp_fts_sensor_force" site="right_ur_arm_ft_frame"/>
				<torque name="right_ur_arm_tcp_fts_sensor_torque" site="right_ur_arm_ft_frame"/>
			</sensor>
			<sensor>
				<framequat name="imu_sensor_quat" objname="imu_0_link" objtype="site"/>
				<gyro name="imu_sensor_gyro" site="imu_0_link"/>
				<accelerometer name="imu_sensor_accel" site="imu_0_link"/>
			</sensor>
			<sensor>
				<rangefinder name="lidar2d_0" site="lidar2d_0"/>
			</sensor>
		</raw_inputs>
		<!-- Process arguments for the URDF -->
		<processed_inputs>
			<decompose_mesh mesh_name="finger_1" threshold="0.05"/>
			<!-- <decompose_mesh mesh_name="finger_v6" threshold="0.05"/> -->
			<camera fovy="58" mode="fixed" name="left_wrist_mounted_camera" resolution="1280 720" site="left_wrist_mounted_camera_color_optical_frame"/>
			<camera fovy="58" mode="fixed" name="right_wrist_mounted_camera" resolution="1280 720" site="right_wrist_mounted_camera_color_optical_frame"/>
			<lidar angle_increment="0.1" max_angle="2.3" min_angle="-2.3" ref_site="lidar2d_0_laser" sensor_name="lidar2d_0"/>
			<!-- <decompose_mesh mesh_name="finger_v6" threshold="0.05"/> -->
			<!-- Add frictionloss and armature to fingers to help with backdriving -->
			<modify_element armature="0.5" frictionloss="5.0" name="left_finger_1_joint" type="joint"/>
			<modify_element armature="0.5" frictionloss="5.0" name="left_finger_2_joint" type="joint"/>
			<modify_element armature="0.5" frictionloss="5.0" name="right_finger_1_joint" type="joint"/>
			<modify_element armature="0.5" frictionloss="5.0" name="right_finger_2_joint" type="joint"/>
      .
			<!-- Add gravcomp so that control will make the joints move about the desired position-->
			<modify_element gravcomp="1.0" name="left_ewellix_lift_higher_link" type="body"/>
			<modify_element gravcomp="1.0" name="left_ewellix_lift_middle_link" type="body"/>
			<modify_element gravcomp="1.0" name="left_ur_arm_shoulder_link" type="body"/>
			<modify_element gravcomp="1.0" name="left_ur_arm_upper_arm_link" type="body"/>
			<modify_element gravcomp="1.0" name="left_ur_arm_forearm_link" type="body"/>
			<modify_element gravcomp="1.0" name="left_ur_arm_wrist_1_link" type="body"/>
			<modify_element gravcomp="1.0" name="left_ur_arm_wrist_2_link" type="body"/>
			<modify_element gravcomp="1.0" name="left_ur_arm_wrist_3_link" type="body"/>
			<modify_element gravcomp="1.0" name="left_finger_1_link" type="body"/>
			<modify_element gravcomp="1.0" name="left_finger_2_link" type="body"/>
			<modify_element gravcomp="1.0" name="right_ewellix_lift_higher_link" type="body"/>
			<modify_element gravcomp="1.0" name="right_ewellix_lift_middle_link" type="body"/>
			<modify_element gravcomp="1.0" name="right_ur_arm_shoulder_link" type="body"/>
			<modify_element gravcomp="1.0" name="right_ur_arm_upper_arm_link" type="body"/>
			<modify_element gravcomp="1.0" name="right_ur_arm_forearm_link" type="body"/>
			<modify_element gravcomp="1.0" name="right_ur_arm_wrist_1_link" type="body"/>
			<modify_element gravcomp="1.0" name="right_ur_arm_wrist_2_link" type="body"/>
			<modify_element gravcomp="1.0" name="right_ur_arm_wrist_3_link" type="body"/>
		</processed_inputs>
		<!-- scene which describes general settings -->
		<scene>
			<statistic center="0.0 0 0.4" extent="5.0"/>
			<option gravity="0 0 -9.81">
				<flag contact="enable"/>
			</option>
			<visual>
				<rgba haze="0.15 0.25 0.35 1"/>
				<!-- initial camera starting angle and elevation -->
				<global azimuth="-120" elevation="-30" offheight="720" offwidth="1280"/>
			</visual>
			<!-- [In progress] this stuff will go away once Zarrin gets the environment urdf-ified -->
			<compiler angle="radian"/>
			<!-- assetdir="assets" /> -->
			<asset>
				<texture builtin="gradient" height="3072" rgb1="0.3 0.5 0.7" rgb2="0 0 0" type="skybox" width="512"/>
				<texture builtin="checker" height="300" mark="edge" markrgb="0.5 0.5 0.5" name="groundplane" rgb1="0.8 0.8 0.8" rgb2="0.8 0.8 0.8" type="2d" width="300"/>
				<material name="groundplane" reflectance="0.0" texrepeat="3.0 3.0" texture="groundplane" texuniform="true"/>
			</asset>
			<worldbody>
				<light castshadow="false" dir="0 0 -1" directional="true" pos="0 0 3"/>
				<!-- Keeping the floor because the floor isn't defined in the URDF -->
				<geom material="groundplane" name="floor" size="0 0 0.05" type="plane"/>
			</worldbody>
		</scene>
	</mujoco_inputs>
	<ros2_control name="MujocoSystem" type="system">
		<hardware>
			<plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
			<!-- uncomment to start from saved keyframe -->
			<!-- <param name="override_start_position_file">$(arg override_start_position_file)</param> -->
			<!-- Increase this parameter to run the sim faster than realtime. -->
			<param name="sim_speed_factor">1.0</param>
			<!-- Publish camera images at 2 hz -->
			<param name="camera_publish_rate">2.0</param>
		</hardware>
		<sensor name="left_wrist_mounted_camera">
			<param name="frame_name">left_wrist_mounted_camera_color_optical_frame</param>
			<param name="info_topic">/left_wrist_mounted_camera_/color/camera_info</param>
			<param name="image_topic">/left_wrist_mounted_camera_/color/image_raw</param>
			<param name="depth_topic">/left_wrist_mounted_camera_/aligned_depth_to_color/image_raw</param>
		</sensor>
		<sensor name="right_wrist_mounted_camera">
			<param name="frame_name">right_wrist_mounted_camera_color_optical_frame</param>
			<param name="info_topic">/right_wrist_mounted_camera_/color/camera_info</param>
			<param name="image_topic">/right_wrist_mounted_camera_/color/image_raw</param>
			<param name="depth_topic">/right_wrist_mounted_camera_/aligned_depth_to_color/image_raw</param>
		</sensor>
		<sensor name="lidar2d_0">
			<param name="frame_name">lidar2d_0_laser</param>
