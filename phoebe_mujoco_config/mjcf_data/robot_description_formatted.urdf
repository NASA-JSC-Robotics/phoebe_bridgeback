  <xacro:property name="right_liftkit_calibration_file" value="${right_liftkit_calibration_file}"/> -->
	<joint name="left_ewellix_lift_base_joint" type="fixed">
		<parent link="left_ewellix_mount_flange_link"/>
		<child link="left_ewellix_lift_lower_link"/>
		<origin rpy="0 0 0" xyz="0 0 0.2532"/>
	</joint>
	<!--LOWER-->
	<link name="left_ewellix_lift_lower_link">
		<inertial>
			<mass value="6.746306"/>
			<inertia ixx="0.1579129" ixy="0" ixz="0" iyy="0.1578582" iyz="0" izz="0.053799503"/>
		</inertial>
		<visual>
			<geometry>
				<mesh filename="full/lift_low_500mm.obj"/>
			</geometry>
			<material name="gray"/>
		</visual>
	</link>
	<!--MIDDLE-->
	<link name="left_ewellix_lift_middle_link">
		<inertial>
			<mass value="5.411604"/>
			<inertia ixx="0.11963018" ixy="0" ixz="0" iyy="0.11963018" iyz="0" izz="0.033099694"/>
		</inertial>
		<visual>
			<geometry>
				<mesh filename="full/lift_mid_500mm.obj"/>
			</geometry>
			<material name="gray"/>
		</visual>
	</link>
	<!--HIGHER-->
	<link name="left_ewellix_lift_higher_link">
		<inertial>
			<mass value="5.324879"/>
			<inertia ixx="0.12572077" ixy="0" ixz="0" iyy="0.12571806" iyz="0" izz="0.024552208"/>
		</inertial>
		<visual>
			<geometry>
				<mesh filename="full/lift_high_500mm.obj"/>
			</geometry>
			<material name="gray"/>
		</visual>
	</link>
	<!--LOWER TO HIGHER (PRISMATIC)-->
	<joint name="left_ewellix_lift_lower_to_higher" type="prismatic">
		<parent link="left_ewellix_lift_lower_link"/>
		<child link="left_ewellix_lift_higher_link"/>
		<origin rpy="0 0 0" xyz="0 0 0.0368"/>
		<axis xyz="0 0 1"/>
		<limit effort="1000" lower="0" upper="0.5" velocity="1"/>
	</joint>
	<!--MIDDLE MIMIC HIGHER (PRISMATIC MIMIC)-->
	<joint name="left_middle_mimic_higher" type="prismatic">
		<parent link="left_ewellix_lift_higher_link"/>
		<child link="left_ewellix_lift_middle_link"/>
		<origin rpy="0 0 0" xyz="0 0 -0.0303"/>
		<axis xyz="0 0 -1"/>
		<limit effort="1000" lower="0" upper="0.25" velocity="1"/>
		<mimic joint="left_ewellix_lift_lower_to_higher" multiplier="0.5" offset="0"/>
	</joint>
	<link name="left_ewellix_lift_tip_link"/>
	<joint name="left_ewellix_lift_tip_joint" type="fixed">
		<parent link="left_ewellix_lift_higher_link"/>
		<child link="left_ewellix_lift_tip_link"/>
		<origin rpy="0 0 0" xyz="0 0 0.245"/>
	</joint>
	<!-- Left arm mount plate -->
	<link name="left_arm_mount_plate">
		<visual>
			<geometry>
				<mesh filename="full/arm_mount.obj"/>
			</geometry>
			<material name="clearpath_black"/>
		</visual>
	</link>
	<joint name="left_arm_mount_plate_joint" type="fixed">
		<parent link="left_ewellix_lift_tip_link"/>
		<child link="left_arm_mount_plate"/>
		<origin rpy="0 0 0" xyz="0 0 0"/>
	</joint>
	<joint name="right_ewellix_lift_base_joint" type="fixed">
		<parent link="right_ewellix_mount_flange_link"/>
		<child link="right_ewellix_lift_lower_link"/>
		<origin rpy="0 0 0" xyz="0 0 0.2532"/>
	</joint>
	<!--LOWER-->
	<link name="right_ewellix_lift_lower_link">
		<inertial>
			<mass value="6.746306"/>
			<inertia ixx="0.1579129" ixy="0" ixz="0" iyy="0.1578582" iyz="0" izz="0.053799503"/>
		</inertial>
		<visual>
			<geometry>
				<mesh filename="full/lift_low_500mm.obj"/>
			</geometry>
			<material name="gray"/>
		</visual>
	</link>
	<!--MIDDLE-->
	<link name="right_ewellix_lift_middle_link">
		<inertial>
			<mass value="5.411604"/>
			<inertia ixx="0.11963018" ixy="0" ixz="0" iyy="0.11963018" iyz="0" izz="0.033099694"/>
		</inertial>
		<visual>
			<geometry>
				<mesh filename="full/lift_mid_500mm.obj"/>
			</geometry>
			<material name="gray"/>
		</visual>
	</link>
	<!--HIGHER-->
	<link name="right_ewellix_lift_higher_link">
		<inertial>
			<mass value="5.324879"/>
			<inertia ixx="0.12572077" ixy="0" ixz="0" iyy="0.12571806" iyz="0" izz="0.024552208"/>
		</inertial>
		<visual>
			<geometry>
				<mesh filename="full/lift_high_500mm.obj"/>
			</geometry>
			<material name="gray"/>
		</visual>
	</link>
	<!--LOWER TO HIGHER (PRISMATIC)-->
	<joint name="right_ewellix_lift_lower_to_higher" type="prismatic">
		<parent link="right_ewellix_lift_lower_link"/>
		<child link="right_ewellix_lift_higher_link"/>
		<origin rpy="0 0 0" xyz="0 0 0.0368"/>
		<axis xyz="0 0 1"/>
		<limit effort="1000" lower="0" upper="0.5" velocity="1"/>
	</joint>
	<!--MIDDLE MIMIC HIGHER (PRISMATIC MIMIC)-->
	<joint name="right_middle_mimic_higher" type="prismatic">
		<parent link="right_ewellix_lift_higher_link"/>
		<child link="right_ewellix_lift_middle_link"/>
		<origin rpy="0 0 0" xyz="0 0 -0.0303"/>
		<axis xyz="0 0 -1"/>
		<limit effort="1000" lower="0" upper="0.25" velocity="1"/>
		<mimic joint="right_ewellix_lift_lower_to_higher" multiplier="0.5" offset="0"/>
