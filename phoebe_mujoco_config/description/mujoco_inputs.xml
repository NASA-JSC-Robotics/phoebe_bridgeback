
<mujoco_inputs>
  <option integrator="implicitfast"/>

  <default>
    <default class="phoebe">
      <material specular="0.5" shininess="0.25"/>
      <joint axis="0 1 0" range="-6.28319 6.28319" armature="0.1"/>
      <position ctrlrange="-6.2831 6.2831"/>
      <general biastype="affine" ctrlrange="-6.2831 6.2831"/>
      <default class="size4">
        <joint damping="10"/>
        <general forcerange="-330 330" gainprm="100000" biasprm="0 -100000 -10000"/>
      </default>
      <default class="size3">
        <joint damping="5"/>
        <general forcerange="-150 150" gainprm="40000" biasprm="0 -40000 -4000"/>
        <default class="size3_limited">
          <joint range="-3.1415 3.1415"/>
          <general ctrlrange="-3.1415 3.1415"/>
        </default>
      </default>
      <default class="size2">
        <joint damping="2"/>
        <general forcerange="-56 56" gainprm="10000" biasprm="0 -10000 -1000"/>
      </default>
      <default class="hande">
        <joint damping="2"/>
        <general forcerange="-50 50" ctrlrange="0.0 0.025" gainprm="1000" biasprm="0 -1000 -100"/>
      </default>
      <default class="visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom group="3" type="mesh"/>
      </default>
    </default>
  </default>

  <actuator>
    <position joint="left_ewellix_lift_lower_to_higher" name="left_ewellix_lift_lower_to_higher" kp="75000" dampratio="1.0" ctrlrange="0.0 0.7" />
    <position joint="right_ewellix_lift_lower_to_higher" name="right_ewellix_lift_lower_to_higher" kp="75000" dampratio="1.0" ctrlrange="0.0 0.7" />
    <position joint="left_finger_1_joint" name="left_finger_1_joint" kp="10000" dampratio="100.0" ctrlrange="0.0 0.025" forcerange="-50 50"/>
    <position joint="right_finger_1_joint" name="right_finger_1_joint" kp="10000" dampratio="100.0" ctrlrange="0.0 0.025" forcerange="-50 50"/>

    <general class="size4" name="left_ur_arm_shoulder_pan_joint" joint="left_ur_arm_shoulder_pan_joint"/>
    <general class="size4" name="left_ur_arm_shoulder_lift_joint" joint="left_ur_arm_shoulder_lift_joint"/>
    <general class="size3_limited" name="left_ur_arm_elbow_joint" joint="left_ur_arm_elbow_joint"/>
    <general class="size2" name="left_ur_arm_wrist_1_joint" joint="left_ur_arm_wrist_1_joint"/>
    <general class="size2" name="left_ur_arm_wrist_2_joint" joint="left_ur_arm_wrist_2_joint"/>
    <general class="size2" name="left_ur_arm_wrist_3_joint" joint="left_ur_arm_wrist_3_joint"/>

    <general class="size4" name="right_ur_arm_shoulder_pan_joint" joint="right_ur_arm_shoulder_pan_joint"/>
    <general class="size4" name="right_ur_arm_shoulder_lift_joint" joint="right_ur_arm_shoulder_lift_joint"/>
    <general class="size3_limited" name="right_ur_arm_elbow_joint" joint="right_ur_arm_elbow_joint"/>
    <general class="size2" name="right_ur_arm_wrist_1_joint" joint="right_ur_arm_wrist_1_joint"/>
    <general class="size2" name="right_ur_arm_wrist_2_joint" joint="right_ur_arm_wrist_2_joint"/>
    <general class="size2" name="right_ur_arm_wrist_3_joint" joint="right_ur_arm_wrist_3_joint"/>

    <velocity name="front_right_wheel_joint" joint="front_right_wheel_joint" ctrlrange="-15 15" kv="50"/>
    <velocity name="front_left_wheel_joint" joint="front_left_wheel_joint" ctrlrange="-15 15" kv="50"/>
    <velocity name="rear_right_wheel_joint" joint="rear_right_wheel_joint" ctrlrange="-15 15" kv="50"/>
    <velocity name="rear_left_wheel_joint" joint="rear_left_wheel_joint" ctrlrange="-15 15" kv="50"/>
  </actuator>

  <contact>
    <exclude body1="base_link" body2="left_ewellix_lift_higher_link"/>
    <exclude body1="base_link" body2="left_ewellix_lift_middle_link"/>
    <exclude body1="base_link" body2="right_ewellix_lift_higher_link"/>
    <exclude body1="base_link" body2="right_ewellix_lift_middle_link"/>
    <exclude body1="base_link" body2="front_left_wheel_link"/>
    <exclude body1="base_link" body2="front_right_wheel_link"/>
    <exclude body1="base_link" body2="rear_left_wheel_link"/>
    <exclude body1="base_link" body2="rear_right_wheel_link"/>
  </contact>

  <tendon>
    <fixed name="left_split">
      <joint joint="left_finger_1_joint" coef="0.5"/>
      <joint joint="left_finger_2_joint" coef="0.5"/>
    </fixed>
  </tendon>
  <tendon>
    <fixed name="right_split">
      <joint joint="right_finger_1_joint" coef="0.5"/>
      <joint joint="right_finger_2_joint" coef="0.5"/>
    </fixed>
  </tendon>

  <equality>
    <joint joint1="left_finger_1_joint" joint2="left_finger_2_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>
  <equality>
    <joint joint1="right_finger_1_joint" joint2="right_finger_2_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>

  <!-- Same logic as above... -->
  <tendon>
    <fixed name="left_lift_middle_mimic_higher">
      <joint joint="left_ewellix_lift_lower_to_higher" coef="0.5"/>
      <joint joint="left_middle_mimic_higher" coef="0.5"/>
    </fixed>
  </tendon>
  <tendon>
    <fixed name="right_lift_middle_mimic_higher">
      <joint joint="right_ewellix_lift_lower_to_higher" coef="0.5"/>
      <joint joint="right_middle_mimic_higher" coef="0.5"/>
    </fixed>
  </tendon>

  <!-- The mimic joint is scaled by 50% in the URDF -->
  <equality>
    <joint name="left_upper_mimic_lower" joint1="left_ewellix_lift_lower_to_higher" joint2="left_middle_mimic_higher" polycoef="0 2 0 0 0"/>
  </equality>
  <equality>
    <joint name="right_upper_mimic_lower" joint1="right_ewellix_lift_lower_to_higher" joint2="right_middle_mimic_higher" polycoef="0 2 0 0 0"/>
  </equality>

  <sensor>
    <force name="left_ur_arm_tcp_fts_sensor_force" site="left_ur_arm_ft_frame"/>
    <torque name="left_ur_arm_tcp_fts_sensor_torque" site="left_ur_arm_ft_frame"/>
  </sensor>
  <sensor>
    <force name="right_ur_arm_tcp_fts_sensor_force" site="right_ur_arm_ft_frame"/>
    <torque name="right_ur_arm_tcp_fts_sensor_torque" site="right_ur_arm_ft_frame"/>
  </sensor>

  <!-- Excluding contact checking between adjacent bodies that otherwise prevent movement. -->

  <converter_inputs>
    <!-- <decompose_mesh mesh_name="finger_v6" threshold="0.05"/> -->
  </converter_inputs>

</mujoco_inputs>
