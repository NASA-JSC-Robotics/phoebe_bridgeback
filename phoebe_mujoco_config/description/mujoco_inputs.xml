
<mujoco_inputs>
  <!-- Copied directly into the final MJCF -->
  <raw_inputs>
    <option integrator="implicitfast" impratio="20" cone="elliptic" noslip_iterations="5">
      <flag multiccd="enable"/>
    </option>
    <default>
      <default class="phoebe">
        <material specular="0.5" shininess="0.25"/>
        <joint axis="0 1 0" range="-6.28319 6.28319" armature="0.5"/>
        <position ctrlrange="-6.2831 6.2831"/>
        <general biastype="affine" ctrlrange="-6.2831 6.2831"/>
        <default class="size4">
          <joint damping="10"/>
          <position forcerange="-330 330" kp="2000" dampratio="1.0"/>
        </default>
        <default class="size3">
          <joint damping="5"/>
          <position forcerange="-150 150" kp="2000" dampratio="1.0"/>
          <default class="size3_limited">
            <joint range="-3.1415 3.1415"/>
            <position ctrlrange="-3.1415 3.1415"/>
          </default>
        </default>
        <default class="size2">
          <joint damping="5"/>
          <position forcerange="-56 56" kp="500" dampratio="1.0"/>
        </default>
        <default class="visual">
          <geom group="2" type="mesh" contype="0" conaffinity="0"/>
        </default>
        <default class="collision">
          <geom group="3" type="mesh"/>
          <default class="rubber">
            <geom condim="6" friction="1.0 0.1 0.1" priority="1" solimp="0.0 0.95 0.005 0.1 6" solref="0.002 3" conaffinity="1"/>
          </default>
        </default>
        <default class="right_spring_link">
          <joint range="-0.9 0.29670597283" armature="0.001" stiffness="0.05" springref="-2.62" damping="0.00125"/>
        </default>
        <default class="left_spring_link">
          <joint range="-0.29670597283 0.9" armature="0.001" stiffness="0.05" springref="2.62" damping="0.00125"/>
        </default>
      </default>
    </default>

  <actuator>
    <position joint="left_ewellix_lift_lower_to_higher" name="left_ewellix_lift_lower_to_higher" kp="5000" dampratio="1.0" ctrlrange="0.0 0.7"/>
    <position joint="right_ewellix_lift_lower_to_higher" name="right_ewellix_lift_lower_to_higher" kp="5000" dampratio="1.0" ctrlrange="0.0 0.7"/>
    <general biastype="affine" name="right_robotiq_85_left_knuckle_joint" tendon="right_split" forcerange="-10 10" ctrlrange="0 0.8" gainprm="100 0 0" biasprm="0 -100 -25"/>
    <general biastype="affine" name="left_robotiq_85_left_knuckle_joint" tendon="left_split" forcerange="-10 10" ctrlrange="0 0.8" gainprm="100 0 0" biasprm="0 -100 -25"/>
    <position class="size4" name="left_ur_arm_shoulder_pan_joint" joint="left_ur_arm_shoulder_pan_joint"/>
    <position class="size4" name="left_ur_arm_shoulder_lift_joint" joint="left_ur_arm_shoulder_lift_joint"/>
    <position class="size3_limited" name="left_ur_arm_elbow_joint" joint="left_ur_arm_elbow_joint"/>
    <position class="size2" name="left_ur_arm_wrist_1_joint" joint="left_ur_arm_wrist_1_joint"/>
    <position class="size2" name="left_ur_arm_wrist_2_joint" joint="left_ur_arm_wrist_2_joint"/>
    <position class="size2" name="left_ur_arm_wrist_3_joint" joint="left_ur_arm_wrist_3_joint"/>
    <position class="size4" name="right_ur_arm_shoulder_pan_joint" joint="right_ur_arm_shoulder_pan_joint"/>
    <position class="size4" name="right_ur_arm_shoulder_lift_joint" joint="right_ur_arm_shoulder_lift_joint"/>
    <position class="size3_limited" name="right_ur_arm_elbow_joint" joint="right_ur_arm_elbow_joint"/>
    <position class="size2" name="right_ur_arm_wrist_1_joint" joint="right_ur_arm_wrist_1_joint"/>
    <position class="size2" name="right_ur_arm_wrist_2_joint" joint="right_ur_arm_wrist_2_joint"/>
    <position class="size2" name="right_ur_arm_wrist_3_joint" joint="right_ur_arm_wrist_3_joint"/>
    <velocity name="front_right_wheel_joint" joint="front_right_wheel_joint" ctrlrange="-15 15" kv="50"/>
    <velocity name="front_left_wheel_joint" joint="front_left_wheel_joint" ctrlrange="-15 15" kv="50"/>
    <velocity name="rear_right_wheel_joint" joint="rear_right_wheel_joint" ctrlrange="-15 15" kv="50"/>
    <velocity name="rear_left_wheel_joint" joint="rear_left_wheel_joint" ctrlrange="-15 15" kv="50"/>
  </actuator>

  <contact>
    <exclude body1="base_link" body2="left_ewellix_lift_higher_link"/>
    <exclude body1="base_link" body2="left_ewellix_lift_middle_link"/>
    <exclude body1="base_link" body2="right_ewellix_lift_higher_link"/>
    <exclude body1="base_link" body2="right_ewellix_lift_middle_link"/>

    <exclude body1="base_link" body2="rear_left_wheel_link"/>
    <exclude body1="base_link" body2="rear_left_wheel_roller_0_link"/>
    <exclude body1="base_link" body2="rear_left_wheel_roller_1_link"/>
    <exclude body1="base_link" body2="rear_left_wheel_roller_2_link"/>
    <exclude body1="base_link" body2="rear_left_wheel_roller_3_link"/>
    <exclude body1="base_link" body2="rear_left_wheel_roller_4_link"/>
    <exclude body1="base_link" body2="rear_left_wheel_roller_5_link"/>
    <exclude body1="base_link" body2="rear_left_wheel_roller_6_link"/>
    <exclude body1="base_link" body2="rear_left_wheel_roller_7_link"/>

    <exclude body1="base_link" body2="rear_right_wheel_link"/>
    <exclude body1="base_link" body2="rear_right_wheel_roller_0_link"/>
    <exclude body1="base_link" body2="rear_right_wheel_roller_1_link"/>
    <exclude body1="base_link" body2="rear_right_wheel_roller_2_link"/>
    <exclude body1="base_link" body2="rear_right_wheel_roller_3_link"/>
    <exclude body1="base_link" body2="rear_right_wheel_roller_4_link"/>
    <exclude body1="base_link" body2="rear_right_wheel_roller_5_link"/>
    <exclude body1="base_link" body2="rear_right_wheel_roller_6_link"/>
    <exclude body1="base_link" body2="rear_right_wheel_roller_7_link"/>

    <exclude body1="base_link" body2="front_left_wheel_link"/>
    <exclude body1="base_link" body2="front_left_wheel_roller_0_link"/>
    <exclude body1="base_link" body2="front_left_wheel_roller_1_link"/>
    <exclude body1="base_link" body2="front_left_wheel_roller_2_link"/>
    <exclude body1="base_link" body2="front_left_wheel_roller_3_link"/>
    <exclude body1="base_link" body2="front_left_wheel_roller_4_link"/>
    <exclude body1="base_link" body2="front_left_wheel_roller_5_link"/>
    <exclude body1="base_link" body2="front_left_wheel_roller_6_link"/>
    <exclude body1="base_link" body2="front_left_wheel_roller_7_link"/>

    <exclude body1="base_link" body2="front_right_wheel_link"/>
    <exclude body1="base_link" body2="front_right_wheel_roller_0_link"/>
    <exclude body1="base_link" body2="front_right_wheel_roller_1_link"/>
    <exclude body1="base_link" body2="front_right_wheel_roller_2_link"/>
    <exclude body1="base_link" body2="front_right_wheel_roller_3_link"/>
    <exclude body1="base_link" body2="front_right_wheel_roller_4_link"/>
    <exclude body1="base_link" body2="front_right_wheel_roller_5_link"/>
    <exclude body1="base_link" body2="front_right_wheel_roller_6_link"/>
    <exclude body1="base_link" body2="front_right_wheel_roller_7_link"/>
  </contact>

  <!-- let hand - 2f-85 -->
  <tendon>
    <fixed name="left_split">
      <joint joint="left_robotiq_85_left_knuckle_joint" coef="0.485"/>
      <joint joint="left_robotiq_85_right_knuckle_joint" coef="-0.485"/>
    </fixed>
  </tendon>

  <equality>
    <connect anchor="-0.0371575 0.0 0.043422" body1="left_robotiq_85_right_inner_knuckle_link" body2="left_robotiq_85_right_finger_tip_link" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <connect anchor="0.0371575 0.0 0.043422" body1="left_robotiq_85_left_inner_knuckle_link" body2="left_robotiq_85_left_finger_tip_link" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="left_robotiq_85_left_knuckle_joint" joint2="left_robotiq_85_right_knuckle_joint" polycoef="0 -1 0 0 0" solimp="0.95 0.99 0.001"
    solref="0.005 1"/>
  </equality>

  <contact>
    <exclude body1="left_ur_arm_wrist_3_link" body2="left_robotiq_85_right_inner_knuckle_link"/>
    <exclude body1="left_ur_arm_wrist_3_link" body2="left_robotiq_85_left_inner_knuckle_link"/>
    <exclude body1="left_ur_arm_wrist_3_link" body2="left_robotiq_85_right_knuckle_link"/>
    <exclude body1="left_ur_arm_wrist_3_link" body2="left_robotiq_85_left_knuckle_link"/>
    <exclude body1="left_ur_arm_wrist_3_link" body2="left_robotiq_85_right_finger_tip_link"/>
    <exclude body1="left_ur_arm_wrist_3_link" body2="left_robotiq_85_left_finger_tip_link"/>
    <exclude body1="left_robotiq_85_right_finger_tip_link" body2="left_robotiq_85_right_knuckle_link"/>
    <exclude body1="left_robotiq_85_left_finger_tip_link" body2="left_robotiq_85_left_knuckle_link"/>
    <exclude body1="left_robotiq_85_right_finger_tip_link" body2="left_robotiq_85_right_finger_coupler_link"/>
    <exclude body1="left_robotiq_85_left_finger_tip_link" body2="left_robotiq_85_left_finger_coupler_link"/>
    <exclude body1="left_robotiq_85_right_knuckle_link" body2="left_robotiq_85_right_finger_coupler_link"/>
    <exclude body1="left_robotiq_85_left_knuckle_link" body2="left_robotiq_85_left_finger_coupler_link"/>
    <exclude body1="left_robotiq_85_right_inner_knuckle_link" body2="left_robotiq_85_right_finger_tip_link"/>
    <exclude body1="left_robotiq_85_left_inner_knuckle_link" body2="left_robotiq_85_left_finger_tip_link"/>
    <exclude body1="left_robotiq_85_right_inner_knuckle_link" body2="left_robotiq_85_right_finger_coupler_link"/>
    <exclude body1="left_robotiq_85_left_inner_knuckle_link" body2="left_robotiq_85_left_finger_coupler_link"/>
    <exclude body1="left_robotiq_85_right_inner_knuckle_link" body2="left_robotiq_85_right_knuckle_link"/>
    <exclude body1="left_robotiq_85_left_inner_knuckle_link" body2="left_robotiq_85_left_knuckle_link"/>
  </contact>

  <!-- right hand - 2f-85 -->
  <tendon>
    <fixed name="right_split">
      <joint joint="right_robotiq_85_left_knuckle_joint" coef="0.485"/>
      <joint joint="right_robotiq_85_right_knuckle_joint" coef="-0.485"/>
    </fixed>
  </tendon>

  <equality>
    <connect anchor="-0.0371575 0.0 0.043422" body1="right_robotiq_85_right_inner_knuckle_link" body2="right_robotiq_85_right_finger_tip_link" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <connect anchor="0.0371575 0.0 0.043422" body1="right_robotiq_85_left_inner_knuckle_link" body2="right_robotiq_85_left_finger_tip_link" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="right_robotiq_85_left_knuckle_joint" joint2="right_robotiq_85_right_knuckle_joint" polycoef="0 -1 0 0 0" solimp="0.95 0.99 0.001"
    solref="0.005 1"/>
  </equality>

  <contact>
    <exclude body1="right_ur_arm_wrist_3_link" body2="right_robotiq_85_right_inner_knuckle_link"/>
    <exclude body1="right_ur_arm_wrist_3_link" body2="right_robotiq_85_left_inner_knuckle_link"/>
    <exclude body1="right_ur_arm_wrist_3_link" body2="right_robotiq_85_right_knuckle_link"/>
    <exclude body1="right_ur_arm_wrist_3_link" body2="right_robotiq_85_left_knuckle_link"/>
    <exclude body1="right_ur_arm_wrist_3_link" body2="right_robotiq_85_right_finger_tip_link"/>
    <exclude body1="right_ur_arm_wrist_3_link" body2="right_robotiq_85_left_finger_tip_link"/>
    <exclude body1="right_robotiq_85_right_finger_tip_link" body2="right_robotiq_85_right_knuckle_link"/>
    <exclude body1="right_robotiq_85_left_finger_tip_link" body2="right_robotiq_85_left_knuckle_link"/>
    <exclude body1="right_robotiq_85_right_finger_tip_link" body2="right_robotiq_85_right_finger_coupler_link"/>
    <exclude body1="right_robotiq_85_left_finger_tip_link" body2="right_robotiq_85_left_finger_coupler_link"/>
    <exclude body1="right_robotiq_85_right_knuckle_link" body2="right_robotiq_85_right_finger_coupler_link"/>
    <exclude body1="right_robotiq_85_left_knuckle_link" body2="right_robotiq_85_left_finger_coupler_link"/>
    <exclude body1="right_robotiq_85_right_inner_knuckle_link" body2="right_robotiq_85_right_finger_tip_link"/>
    <exclude body1="right_robotiq_85_left_inner_knuckle_link" body2="right_robotiq_85_left_finger_tip_link"/>
    <exclude body1="right_robotiq_85_right_inner_knuckle_link" body2="right_robotiq_85_right_finger_coupler_link"/>
    <exclude body1="right_robotiq_85_left_inner_knuckle_link" body2="right_robotiq_85_left_finger_coupler_link"/>
    <exclude body1="right_robotiq_85_right_inner_knuckle_link" body2="right_robotiq_85_right_knuckle_link"/>
    <exclude body1="right_robotiq_85_left_inner_knuckle_link" body2="right_robotiq_85_left_knuckle_link"/>
  </contact>

  <!-- Same logic as above... but for liftkits -->
  <tendon>
    <fixed name="left_lift_middle_mimic_higher">
      <joint joint="left_ewellix_lift_lower_to_higher" coef="0.5"/>
      <joint joint="left_middle_mimic_higher" coef="0.5"/>
    </fixed>
  </tendon>
  <tendon>
    <fixed name="right_lift_middle_mimic_higher">
      <joint joint="right_ewellix_lift_lower_to_higher" coef="0.5"/>
      <joint joint="right_middle_mimic_higher" coef="0.5"/>
    </fixed>
  </tendon>

  <!-- The mimic joint is scaled by 50% in the URDF -->
  <equality>
    <joint name="left_upper_mimic_lower" joint1="left_ewellix_lift_lower_to_higher" joint2="left_middle_mimic_higher" polycoef="0 2 0 0 0"/>
  </equality>
  <equality>
    <joint name="right_upper_mimic_lower" joint1="right_ewellix_lift_lower_to_higher" joint2="right_middle_mimic_higher" polycoef="0 2 0 0 0"/>
  </equality>

  <sensor>
    <force name="left_ur_arm_tcp_fts_sensor_force" site="left_ur_arm_tool0"/>
    <torque name="left_ur_arm_tcp_fts_sensor_torque" site="left_ur_arm_tool0"/>
  </sensor>
  <sensor>
    <force name="right_ur_arm_tcp_fts_sensor_force" site="right_ur_arm_tool0"/>
    <torque name="right_ur_arm_tcp_fts_sensor_torque" site="right_ur_arm_tool0"/>
  </sensor>

  <sensor>
    <framequat name="imu_sensor_quat" objtype="site" objname="imu_0_link" />
    <gyro name="imu_sensor_gyro" site="imu_0_link" />
    <accelerometer name="imu_sensor_accel" site="imu_0_link" />
  </sensor>

  <sensor>
    <rangefinder name="lidar2d_0" site="lidar2d_0"/>
  </sensor>

  <asset>
    <material name="robotiq_black" specular="0.2" shininess="1.0" rgba="0.03137255 0.03137255 0.03137255 1.0"/>
    <material name="robotiq_gray" specular="0.2" shininess="1.0" rgba="0.8 0.8 0.8 1.0"/>
  </asset>

  </raw_inputs>

  <processed_inputs>

    <camera site="left_wrist_mounted_camera_color_optical_frame" name="left_wrist_mounted_camera" fovy="58" mode="fixed" resolution="1280 720"/>
    <camera site="right_wrist_mounted_camera_color_optical_frame" name="right_wrist_mounted_camera" fovy="58" mode="fixed" resolution="1280 720"/>

    <lidar ref_site="lidar2d_0_laser" sensor_name="lidar2d_0" min_angle="-2.3" max_angle="2.3" angle_increment="0.1" />

    <!-- Add gravcomp so that control will make the joints move about the desired position-->
    <modify_element type="body" name="left_ewellix_lift_higher_link" gravcomp="1.0"/>
    <modify_element type="body" name="left_ewellix_lift_middle_link" gravcomp="1.0"/>
    <modify_element type="body" name="left_ur_arm_shoulder_link" gravcomp="1.0"/>
    <modify_element type="body" name="left_ur_arm_upper_arm_link" gravcomp="1.0"/>
    <modify_element type="body" name="left_ur_arm_forearm_link" gravcomp="1.0"/>
    <modify_element type="body" name="left_ur_arm_wrist_1_link" gravcomp="1.0"/>
    <modify_element type="body" name="left_ur_arm_wrist_2_link" gravcomp="1.0"/>
    <modify_element type="body" name="left_ur_arm_wrist_3_link" gravcomp="1.0"/>
    <modify_element type="body" name="right_ewellix_lift_higher_link" gravcomp="1.0"/>
    <modify_element type="body" name="right_ewellix_lift_middle_link" gravcomp="1.0"/>
    <modify_element type="body" name="right_ur_arm_shoulder_link" gravcomp="1.0"/>
    <modify_element type="body" name="right_ur_arm_upper_arm_link" gravcomp="1.0"/>
    <modify_element type="body" name="right_ur_arm_forearm_link" gravcomp="1.0"/>
    <modify_element type="body" name="right_ur_arm_wrist_1_link" gravcomp="1.0"/>
    <modify_element type="body" name="right_ur_arm_wrist_2_link" gravcomp="1.0"/>
    <modify_element type="body" name="right_ur_arm_wrist_3_link" gravcomp="1.0"/>
  </processed_inputs>

</mujoco_inputs>
