  <tendon>
    <fixed name="left_split">
      <joint joint="left_finger_1_joint" coef="0.5"/>
      <joint joint="left_finger_2_joint" coef="0.5"/>
    </fixed>
  </tendon>
  <tendon>
    <fixed name="right_split">
      <joint joint="right_finger_1_joint" coef="0.5"/>
      <joint joint="right_finger_2_joint" coef="0.5"/>
    </fixed>
  </tendon>

  <equality>
    <joint joint1="left_finger_1_joint" joint2="left_finger_2_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>
  <equality>
    <joint joint1="right_finger_1_joint" joint2="right_finger_2_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>

  <!-- Same logic as above... -->
  <tendon>
    <fixed name="left_lift_middle_mimic_higher">
      <joint joint="left_ewellix_lift_lower_to_higher" coef="0.5"/>
      <joint joint="left_middle_mimic_higher" coef="0.5"/>
    </fixed>
  </tendon>
  <tendon>
