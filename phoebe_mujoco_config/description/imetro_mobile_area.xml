<mujoco model="imetro_mobile_area">
  <compiler angle="radian" assetdir="assets" />
  <asset>
    <texture type="2d" name="tag36_11_00001" file="tag36_11_00001.png"/>
    <!-- <material name="tag36h11-1" texture="tag36_11_00001" specular="0.5" shininess="0.25"/> -->
    <material name="tag36h11-1" texture="tag36_11_00001" specular="0.5" shininess="0.25" texrepeat="-1 1"/>


    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <material name="cabinet_black" reflectance="0.2" rgba="0.1 0.1 0.1 1.0"/>
    <material name="table_blue" reflectance="0.2" rgba="0.1 0.1 0.3 1.0"/>
    <material name="desk_brown" reflectance="0.2" rgba="0.42 0.22 0.16 1.0"/>

    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.8 0.8 0.8" rgb2="0.8 0.8 0.8"
      markrgb="0.5 0.5 0.5" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="3.0 3.0" reflectance="0.0"/>

    <mesh name="cylinder" file="cylinder_mockup_short_final_mm_1.stl" scale="0.001 0.001 0.001"/>

  </asset>
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <!-- left bookshelf -->
    <geom size="1.5 0.25 0.75" pos="1.55 -2.25 0.75" quat="1 0 0 0" type="box" material="cabinet_black" class="visual"/>
    <geom size="1.5 0.25 0.75" pos="1.55 -2.25 0.75" quat="1 0 0 0" type="box" class="collision"/>
    <!-- right bookshelf -->
    <geom size="1.5 0.25 0.75" pos="-1.55 -2.25 0.75" quat="1 0 0 0" type="box" material="cabinet_black" class="visual"/>
    <geom size="1.5 0.25 0.75" pos="-1.55 -2.25 0.75" quat="1 0 0 0" type="box" class="collision"/>
    <!-- pick table -->
    <geom size="0.333 0.666 0.333" pos="3.0 -0.666 0.333" quat="1 0 0 0" type="box" material="table_blue" class="visual"/>
    <geom size="0.333 0.666 0.333" pos="3.0 -0.666 0.333" quat="1 0 0 0" type="box" class="collision"/>
    <!-- place table -->
    <geom size="0.333 0.666 0.333" pos="-3.0 -0.666 0.333" quat="1 0 0 0" type="box" material="table_blue" class="visual"/>
    <geom size="0.333 0.666 0.333" pos="-3.0 -0.666 0.333" quat="1 0 0 0" type="box" class="collision"/>
    <!-- left operator desk -->
    <geom size="0.333 0.666 0.333" pos="3.0 1.0 0.333" euler="0 0 0.523599" type="box" material="desk_brown" class="visual"/>
    <geom size="0.333 0.666 0.333" pos="3.0 1.0 0.333" euler="0 0 0.523599" type="box" class="collision"/>
    <!-- right operator desk -->
    <geom size="0.333 0.666 0.333" pos="1.85 2.0 0.333" euler="0 0 1.2" type="box" material="desk_brown" class="visual"/>
    <geom size="0.333 0.666 0.333" pos="1.85 2.0 0.333" euler="0 0 1.2" type="box" class="collision"/>
    <!-- extra operator desks -->
    <geom size="0.333 1.25 0.333" pos="-0.25 2.25 0.333" euler="0 0 1.57" type="box" material="desk_brown" class="visual"/>
    <geom size="0.333 1.25 0.333" pos="-0.25 2.25 0.333" euler="0 0 1.57" type="box" class="collision"/>

    <body name="cylinder" pos="2.75 -0.666 0.665">
      <inertial pos="0 0 -0.1" quat="1 0 0 0" mass="0.25" diaginertia="0.01 0.01 0.01"/>
      <joint name="free_joint" type="free"/>
      <!-- Reference the mesh in a geom -->
      <geom name="cylinder_vis" type="mesh" mesh="cylinder" rgba="0.5 0.5 0.5 1" class="visual"/>
      <geom name="cylinder_col" type="mesh" mesh="cylinder" class="collision"/>
    </body>

    <!-- april tag -->
    <geom material="tag36h11-1" size="0.107 0.107 0.001" pos="0.134059 -1.788736 2.822666" euler="0.785 0 3.14159" type="box" class="visual"/>
  </worldbody>
</mujoco>
