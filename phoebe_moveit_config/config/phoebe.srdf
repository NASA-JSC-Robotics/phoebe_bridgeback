<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="clr">
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="calibration_mode" default="false" />
  <xacro:arg name="use_left_static_pedestal" default="false" />

  <xacro:include filename="$(find phoebe_moveit_config)/config/phoebe_macro.srdf.xacro"/>

  <xacro:phoebe
    tf_prefix="$(arg tf_prefix)"
    calibration_mode="$(arg calibration_mode)"
    use_left_static_pedestal="$(arg use_left_static_pedestal)"
  />

</robot>
