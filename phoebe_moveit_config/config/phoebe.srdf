    <disable_collisions link1="autec_antenna" link2="right_ewellix_lift_lower_link" reason="Never"/>
    <disable_collisions link1="autec_antenna" link2="right_ewellix_lift_middle_link" reason="Never"/>
    <disable_collisions link1="autec_antenna" link2="right_ewellix_mount_flange_link" reason="Adjacent"/>
    <disable_collisions link1="autec_antenna" link2="right_monitor" reason="Never"/>
